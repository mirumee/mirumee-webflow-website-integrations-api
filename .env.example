# Pipedrive
PIPEDRIVE_X_API_TOKEN=
PIPEDRIVE_DEFAULT_USER_ID=

# CORS — comma-separated list of allowed origins (your Webflow domain)
ALLOWED_ORIGINS=https://www.mirumee.com,https://mirumee.com

# Teamtailor (GET /api/get-job-offers)
TEAMTAILOR_API_KEY=
# Optional — company filter on offers; omit if unused
TEAMTAILOR_COMPANY_CUSTOM_FIELD_API_ID=
# Optional — comma-separated list of TT statuses treated as publicly visible.
# Default: "open". Valid values: open, unlisted, archived, draft.
# Client-side filter; TT's filter[status] query param is unreliable on v1.
# TEAMTAILOR_JOBS_ALLOWED_STATUSES=open

# Webflow CMS — POST /api/sync-jobs (Teamtailor → Jobs collection)
# Token needs CMS:read + CMS:write. Collection ID: Webflow → CMS → Jobs → settings / API.
WEBFLOW_API_TOKEN=
WEBFLOW_JOBS_COLLECTION_ID=
# Shared secret: send header x-sync-secret on sync requests (cron, CI, etc.)
SYNC_JOBS_SECRET=
# Optional — JSON map of internal keys → Webflow field slugs (default matches src/lib/webflow-jobs-sync.ts)
# WEBFLOW_JOBS_FIELD_MAP={"title":"name","id":"slug","descriptionHtml":"description","salaryDisplay":"salary-display"}

# Pipedrive deal custom field keys for campaign attribution (contact form).
# Field key = Pipedrive → Settings → Data fields → Deal → field → API key. Unset = skipped.
PIPEDRIVE_FIELD_GA_CLIENT_ID=
PIPEDRIVE_FIELD_UTM_SOURCE=
PIPEDRIVE_FIELD_UTM_MEDIUM=
PIPEDRIVE_FIELD_UTM_CAMPAIGN=
PIPEDRIVE_FIELD_UTM_TERM=
PIPEDRIVE_FIELD_UTM_CONTENT=
PIPEDRIVE_FIELD_GCLID=
PIPEDRIVE_FIELD_LANDING_PAGE=
PIPEDRIVE_FIELD_REFERRER=
# Long-text "Message" deal field; the form message (+ visitor city) is copied there.
PIPEDRIVE_FIELD_MESSAGE=

# Google reCAPTCHA v3 — contact form spam protection.
# Keys: https://www.google.com/recaptcha/admin (register mirumee.com domains).
# Site key is public (used by contact-form.js); secret key verifies tokens server-side.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# Optional — minimum score (0.0–1.0) to accept a submission. Default: 0.5.
# RECAPTCHA_MIN_SCORE=0.5
